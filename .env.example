# Copy to `.env.local` (or `.env`) for local dev. Vite loads these for server functions.
# On Vercel / Cloudflare, set the same names in the project dashboard (or wrangler secrets).

# On-chain stats (/stats/onchain) — Dune query + dashboard link
# DUNE_API_KEY=            # required for cron / node scripts/run-dune-sync.mjs
# DUNE_QUERY_ID=7721677

# Off-chain MCP tool-call stats (/stats/offchain) — Amplitude Export API
# AMPLITUDE_API_KEY=
# AMPLITUDE_SECRET_KEY=
# AMPLITUDE_REGION=us

# Stats cache — Supabase (service role; server-only, never expose to the browser)
# Used by Amplitude export and Dune tagged-txn tables
# CUSTOM_SUPABASE_URL=
# CUSTOM_SUPABASE_SERVICE_ROLE_KEY=

# Vercel Cron — Amplitude export sync (/api/cron/amplitude-sync)
# CRON_SECRET=
