# Copy to `.env.local` (or `.env`) for local dev. Vite loads these for server functions.
# On Cloudflare, set the same names as Worker secrets/vars (wrangler dashboard or `wrangler secret put`).

# Stats API used by /stats/onchain and /stats/offchain (default production host)
# STATS_API_BASE_URL=https://api.stats.usecelina.xyz
